# OpenNexus example configuration
# Copy this file to .env and replace every placeholder before production use.

# Required in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=replace-with-a-long-random-value
SESSION_COOKIE_SECURE=0
APP_BASE_URL=http://localhost:8000

# Used only when the database has no administrator yet.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-password

# WPS Open Platform OAuth application
WPS_APP_ID=
WPS_APP_SECRET=
WPS_REDIRECT_URI=http://localhost:8000/oauth/callback
WPS_WEBHOOK_URL=

# Email notifications and password recovery
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
SMTP_SENDER_EMAIL=
SMTP_SENDER_PASSWORD=
SMTP_SENDER_NAME=OpenNexus

# MCP HTTP access policy
MCP_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Personal WeChat bridge diagnostics (0/1)
WECHAT_SHOW_LOG=0

# Optional fallback allowlists for compliance notifications. File-specific
# “知识推送名单” data takes precedence. Keep real names and IDs only in .env.
COMPLIANCE_MEMBER_NAMES=
COMPLIANCE_MEMBER_IDS=
